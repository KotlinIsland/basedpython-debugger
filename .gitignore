/target

# coverage instrumentation writes these next to whichever binary ran, and a
# single `cargo llvm-cov` run leaves hundreds of them
*.profraw
/site
/.venv
/dist

# scratch files are notes for whoever is working on something, and are not
# committed
scratch.*

# what running the vs code suite leaves behind. `package-lock.json` is committed
# beside them, which is what pins the versions these hold
node_modules/
# a whole vs code, downloaded by `@vscode/test-electron` — the better part of a
# gigabyte, and cached between runs
/editors/vscode/.vscode-test

# what running the intellij build leaves behind. the wrapper's jar and
# properties are committed beside them, which is what pins the gradle these use.
# `.intellijPlatform` holds the layout index and the release list the platform
# plugin caches; the IDE itself lands in the gradle cache rather than here
/editors/intellij/.gradle
/editors/intellij/.intellijPlatform
/editors/intellij/build

.DS_Store
*.pyc
__pycache__/
